# ──────────────────────────────────────────────────────────────────────────────
# SkillSphere Backend — Environment Variables Template
# Copy to .env and fill in real values before running the service.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection URL (Prisma Migrate + runtime queries)
DATABASE_URL=postgresql://skillsphere:skillsphere@localhost:5432/skillsphere?schema=public

# Connection pooling knobs (Prisma built-in pool)
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
DATABASE_CONNECT_TIMEOUT=10

# Application
PORT=4000
NODE_ENV=development

# Stellar / Indexer
INDEXER_INTERVAL_MS=5000
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
