# ──────────────────────────────────────────────────────────────────────────────
# SkillSphere Backend — Environment Variables Template
# Copy to .env and fill in real values before running the service.
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection URL (Prisma Migrate + runtime queries)
DATABASE_URL=postgresql://skillsphere:skillsphere@localhost:5432/skillsphere?schema=public

# Connection pooling knobs (Prisma built-in pool)
DATABASE_CONNECTION_LIMIT=10
DATABASE_POOL_TIMEOUT=10
DATABASE_CONNECT_TIMEOUT=10

# Application
PORT=4000
NODE_ENV=development

# Stellar / Indexer (interval must stay ≤ 2000ms for PaymentStreamed freshness)
INDEXER_INTERVAL_MS=1000
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Comma-separated contract IDs used to filter getEvents (required in production)
ESCROW_CONTRACT_ID=
DISPUTE_CONTRACT_ID=

# Expert notifications (Discord / Telegram) — optional; failures never block the API
# Discord channel incoming webhook URL
DISCORD_WEBHOOK_URL=
# Telegram Bot API sendMessage endpoint, e.g. https://api.telegram.org/bot<token>/sendMessage
TELEGRAM_WEBHOOK_URL=
# Required for Telegram unless chat_id is already a query param on TELEGRAM_WEBHOOK_URL
TELEGRAM_CHAT_ID=
